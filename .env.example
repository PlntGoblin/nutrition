# Copy to .env and fill in real values. Never commit the real .env.
# All Vite-exposed vars must be prefixed VITE_ to reach the browser bundle.

# === Widget runtime (browser) ===
# URL of the deployed Cloudflare Worker that proxies Airtable.
# Leave empty in dev to use the local seed JSON in data/seed-ingredients.json.
VITE_API_URL=

# === Cloudflare Worker secrets (NOT bundled into the widget) ===
# These live in `wrangler secret put <NAME>`. They are listed here as a
# checklist, not as values you put in this file.
#   - AIRTABLE_PAT          Airtable Personal Access Token (server-only)
#   - AIRTABLE_BASE_ID      Airtable base ID (e.g. appXXXXXXXXXXXXXX)
#   - CLOUDINARY_CLOUD_NAME
#   - CLOUDINARY_API_KEY
#   - CLOUDINARY_API_SECRET
#   - ALLOWED_ORIGINS       Comma-separated CORS allowlist (PopMenu domain etc.)
